# Secrets — NEVER commit
**/secrets/
**/*.key
**/*.pem
**/*password*
.env

# step-ca runtime data (managed by Docker volume)
step-ca/db/
step-ca/certs/intermediate*
step-ca/certs/root*.key
step-ca/issued/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Editor
.vscode/
.idea/
*.swp
.DS_Store

# Build artifacts
*.log
*.bak
*.tmp

# ...but DO keep thesis evidence captures (committed as artifacts)
!docs/evidence/**/*.log

# Nginx runtime certs (issued at deploy time)
nginx/certs/

# CA backups (also stored off-repo in ~/thesis-ca-backups)
*.tar.gz.enc
thesis-ca-backups/

# Extracted arm64 step binary (re-extract from smallstep/step-cli:0.28.1; too big for git)
node-agent/deploy/bin/
