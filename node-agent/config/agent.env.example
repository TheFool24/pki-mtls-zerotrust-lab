# Thesis Lab Node Agent — environment file
# Deployed to /etc/thesis-lab/node-config/agent.env on the node host.
# Owned by root, mode 0644 (no secrets here — cert/key paths only).

# Identity
THESIS_NODE_ID=pi-01
THESIS_NODE_COMMON_NAME=pi-01.thesis.local
THESIS_NODE_ROLE=valid

# Controller
THESIS_CONTROLLER_URL=https://controller.thesis.local
THESIS_CONTROLLER_CA=/etc/thesis-lab/certs/ca-root.crt

# mTLS client identity
THESIS_CLIENT_CERT=/etc/thesis-lab/certs/pi-01.crt
THESIS_CLIENT_KEY=/etc/thesis-lab/certs/pi-01.key

# Heartbeat cadence
THESIS_HEARTBEAT_INTERVAL=30
THESIS_HEARTBEAT_JITTER=5

# Metrics listener (mTLS)
THESIS_METRICS_PORT=9100
THESIS_METRICS_BIND=0.0.0.0
THESIS_ALLOWED_SCRAPER_CNS=prometheus.thesis.local

# Logging
THESIS_LOG_LEVEL=INFO
