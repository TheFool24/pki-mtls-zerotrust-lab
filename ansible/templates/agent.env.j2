# Thesis Node Agent configuration — rendered by Ansible for {{ node_id }}.
# Deployed to {{ node_config_dir }}/agent.env (root:root 0644; no secrets here).

# ── Identity ──
THESIS_NODE_ID={{ node_id }}
THESIS_NODE_COMMON_NAME={{ node_cn }}
THESIS_NODE_ROLE={{ node_role }}

# ── Controller ──
THESIS_CONTROLLER_URL={{ controller_url }}
THESIS_CONTROLLER_CA={{ node_certs_dir }}/ca-root.crt

# ── mTLS client identity ──
THESIS_CLIENT_CERT={{ node_certs_dir }}/{{ node_id }}.crt
THESIS_CLIENT_KEY={{ node_certs_dir }}/{{ node_id }}.key

# ── Heartbeat ──
THESIS_HEARTBEAT_INTERVAL={{ heartbeat_interval }}
THESIS_HEARTBEAT_JITTER={{ heartbeat_jitter }}

# ── Metrics listener (scraped by Prometheus over mTLS) ──
THESIS_METRICS_PORT={{ metrics_port }}
THESIS_METRICS_BIND=0.0.0.0
THESIS_ALLOWED_SCRAPER_CNS={{ allowed_scraper_cns }}

# ── Logging ──
THESIS_LOG_LEVEL=INFO
